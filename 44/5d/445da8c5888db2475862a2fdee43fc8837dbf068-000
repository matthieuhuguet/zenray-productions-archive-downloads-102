<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <base href="file:///Users/zenray/Downloads/tmp-thewitcher3-artdirection/">
  <title>Template Creator</title>
  <link rel="stylesheet" href="assets/photo-controls/zr-photo-adjustments.css">
  <style>
    @font-face { font-family: AnthropicSerif; src: url("file:///Users/zenray/Library/Fonts/AnthropicSerif-Regular.ttf"); font-weight: 400; }
    @font-face { font-family: AnthropicMono; src: url("file:///Users/zenray/Library/Fonts/AnthropicMono-Regular.ttf"); font-weight: 400; }
    @font-face { font-family: Inter; src: url("file:///Users/zenray/Library/Fonts/InterVariable.ttf"); font-weight: 100 900; }
    @font-face { font-family: Cinzel; src: url("assets/fonts/Cinzel-Variable.ttf"); font-weight: 400 900; }
    :root {
      --zr-primary-x: 836;
      --zr-primary-y: 503;
      --zr-primary-size: 42;
      --zr-primary-tracking: 10.8;
      --zr-secondary-x: 836;
      --zr-secondary-y: 458;
      --zr-secondary-size: 25;
      --zr-secondary-tracking: 8;
    }
    * { box-sizing: border-box; }
    html, body { width: 100%; min-height: 100%; margin: 0; background: #0b0c0f; }
    body { display: grid; place-items: center; color: white; font-family: Inter, sans-serif; }
    .stage {
      position: relative;
      width: min(100vw, calc(100vh * var(--zr-canvas-ratio)));
      aspect-ratio: var(--zr-canvas-ratio);
      overflow: hidden;
      background: black;
    }
    #photo,
    #text-layers {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }
    #source { display: none; }
    #text-layers { overflow: visible; pointer-events: none; }
    #primary-text,
    #secondary-text,
    #editorial-text {
      fill: var(--zr-text-color, #f0ede5);
      paint-order: stroke fill;
      stroke: rgba(0, 0, 0, 0.18);
      stroke-width: 0.35px;
      text-shadow: var(--zr-text-shadow, 0 1px 2px rgba(0,0,0,0.46));
      text-anchor: middle;
    }
    #primary-text { font-family: var(--zr-primary-family, Cinzel); font-weight: var(--zr-primary-weight, 400); }
    #secondary-text { font-family: var(--zr-secondary-family, Cinzel); font-weight: var(--zr-secondary-weight, 400); }
    #editorial-text { font-family: Cinzel; }
    #editorial-divider,
    #editorial-diamond { stroke: var(--zr-text-color, #f0ede5); fill: none; }
    .zr-photo-panel .template-fields { padding-bottom: 10px; }
    .zr-photo-panel .template-fields input[type="text"] {
      width: 100%;
      min-height: 34px;
      padding: 7px 9px;
      border: 0;
      border-radius: 8px;
      background: #3a3a3a;
      color: white;
      font: 13px Inter, sans-serif;
    }
    html.render body { display: block; }
    html.render .stage { width: var(--zr-canvas-width); height: var(--zr-canvas-height); }
  </style>
</head>
<body>
  <main class="stage" id="stage">
    <img id="source" alt="">
    <canvas id="photo"></canvas>
    <svg id="text-layers" xmlns="http://www.w3.org/2000/svg">
      <text id="primary-text"></text>
      <text id="secondary-text"></text>
      <g id="editorial-layer" hidden>
        <line id="editorial-divider"></line>
        <path id="editorial-diamond"></path>
        <text id="editorial-text"></text>
      </g>
    </svg>
  </main>

  <aside class="zr-photo-panel" aria-label="Réglages du template">
    <h2>Template Creator</h2>
    <div class="template-fields">
      <div class="zr-photo-grid">
        <label>Texte principal<input id="primary-input" type="text"></label>
        <label>Texte secondaire<input id="secondary-input" type="text"></label>
      </div>
      <div id="text-controls" class="zr-photo-grid"></div>
    </div>
    <details open>
      <summary>Vignette</summary>
      <div id="vignette-controls" class="zr-photo-grid"></div>
    </details>
    <details>
      <summary>Selective Color</summary>
      <div id="selective-tabs" class="zr-photo-color-tabs"></div>
      <div id="selective-controls" class="zr-photo-grid"></div>
    </details>
    <details>
      <summary>Levels</summary>
      <div id="levels-controls" class="zr-photo-grid"></div>
    </details>
    <details>
      <summary>Black and White</summary>
      <div id="black-white-controls" class="zr-photo-grid"></div>
    </details>
    <details>
      <summary>Color</summary>
      <div id="color-controls" class="zr-photo-grid"></div>
    </details>
    <details open>
      <summary>Light</summary>
      <div id="light-controls" class="zr-photo-grid"></div>
    </details>
    <details>
      <summary>Filters</summary>
      <div id="filter-buttons" class="zr-photo-filter-grid"></div>
      <div id="filter-controls" class="zr-photo-grid"></div>
    </details>
    <div class="zr-photo-actions">
      <button id="reset" type="button">Réinitialiser</button>
      <button id="copy" type="button">Copier les valeurs</button>
    </div>
    <p id="status" class="zr-photo-status" role="status"></p>
  </aside>

  <script src="assets/photo-controls/zr-photo-adjustments.js"></script>
  <script>
    "use strict";
    const CONFIG = {"canvas": {"width": 1672, "height": 941}, "background": "/Users/zenray/Downloads/tmp-thewitcher3-artdirection/assets/background-02-enhanced-combat-clean.png", "template_id": "editorial_list", "primary_text": "AND SO MUCH MORE", "secondary_text": "", "primary": {"font_url": "/Users/zenray/Downloads/tmp-thewitcher3-artdirection/assets/fonts/Cinzel-Variable.ttf", "font_family": "Cinzel", "font_size": 34.833, "font_weight": 400, "letter_spacing": 0.968, "anchor_x": 327.046, "baseline_y": 497.879, "color": "#d8d1c2", "shadow": "0 1px 2px rgba(0,0,0,0.48)"}, "secondary": null, "photo": {"vignette": 0, "selective": [{"hue": 0, "saturation": 0, "luminance": 0}, {"hue": 0, "saturation": 0, "luminance": 0}, {"hue": 0, "saturation": 0, "luminance": 0}, {"hue": 0, "saturation": 0, "luminance": 0}, {"hue": 0, "saturation": 0, "luminance": 0}, {"hue": 0, "saturation": 0, "luminance": 0}], "levels": {"inputBlack": 0, "midtone": 50, "inputWhite": 100, "outputBlack": 0, "outputWhite": 100}, "blackAndWhite": 0, "saturation": 0, "vibrance": 0, "brilliance": 0, "exposure": 0, "highlights": 0, "shadows": 0, "brightness": 0, "contrast": 0, "blackPoint": 0, "filter": "Original", "filterStrength": 100}, "output": "out/template-previews/generated-template.png", "editorial": {"divider": {"x": 579.588, "y": 282.216, "width": 1.935, "height": 417.005}, "diamond_center_y": 481.452, "list": {"x": 653.125, "first_baseline_y": 177.754, "font_size": 20.319, "letter_spacing": 1.451, "line_height": 36.225, "lines": ["CROSS PLATFORM MOD SUPPORT", "IMMERSIVE MEDITATION", "REFINED ANIMATIONS", "NEW QUEST TRACKING", "UI IMPROVEMENTS", "LOOTING REWORK", "REFRESHED MOTION BLUR", "NEW ACCESSIBILITY FEATURES", "UPDATED TEXTURES", "FOLIAGE SHADING REWORK", "TUTORIAL MODERNIZATION", "HDR IMPROVEMENTS", "GTAO", "IMPROVED MENU NAVIGATION", "RAY TRACING IMPROVEMENTS", "GLOBAL LIGHTING REWORK", "NEW SHADING MODEL", "SUBSURFACE SCATTERING"]}}};
    const root = document.documentElement;
    const canvas = document.querySelector("#photo");
    const source = document.querySelector("#source");
    const primaryText = document.querySelector("#primary-text");
    const secondaryText = document.querySelector("#secondary-text");
    const editorialLayer = document.querySelector("#editorial-layer");
    const editorialDivider = document.querySelector("#editorial-divider");
    const editorialDiamond = document.querySelector("#editorial-diamond");
    const editorialText = document.querySelector("#editorial-text");
    const status = document.querySelector("#status");
    const processor = new ZRPhotoAdjustments(canvas);
    const filterNames = ZRPhotoAdjustments.filters();
    const channelNames = ["Rouge", "Jaune", "Vert", "Cyan", "Bleu", "Magenta"];
    let selectedChannel = 0;
    let selectedFilter = CONFIG.photo.filter;
    let framePending = false;

    root.style.setProperty("--zr-canvas-width", `${CONFIG.canvas.width}px`);
    root.style.setProperty("--zr-canvas-height", `${CONFIG.canvas.height}px`);
    root.style.setProperty("--zr-canvas-ratio", CONFIG.canvas.width / CONFIG.canvas.height);
    document.querySelector("#text-layers").setAttribute("viewBox", `0 0 ${CONFIG.canvas.width} ${CONFIG.canvas.height}`);

    function setVariable(name, value) {
      root.style.setProperty(name, String(value));
    }

    function getVariable(name) {
      return Number.parseFloat(getComputedStyle(root).getPropertyValue(name));
    }

    function slider(parent, label, variable, min, max, value, step = 1) {
      const row = document.createElement("label");
      row.className = "zr-photo-control";
      const name = document.createElement("span");
      name.textContent = label;
      const input = document.createElement("input");
      input.type = "range";
      input.min = min;
      input.max = max;
      input.step = step;
      input.value = value;
      input.dataset.variable = variable;
      const output = document.createElement("output");
      output.value = Math.round(Number(value));
      input.addEventListener("input", () => {
        setVariable(variable, input.value);
        output.value = Math.round(Number(input.value));
        scheduleRender();
      });
      row.append(name, input, output);
      parent.append(row);
      setVariable(variable, value);
      return { input, output };
    }

    function makeControls() {
      const text = document.querySelector("#text-controls");
      slider(text, "Principal X", "--zr-primary-x", 0, CONFIG.canvas.width, CONFIG.primary.anchor_x);
      slider(text, "Principal Y", "--zr-primary-y", 0, CONFIG.canvas.height, CONFIG.primary.baseline_y);
      slider(text, "Taille", "--zr-primary-size", 8, 240, CONFIG.primary.font_size);
      slider(text, "Interlettrage", "--zr-primary-tracking", -20, 100, CONFIG.primary.letter_spacing, 0.1);

      slider(document.querySelector("#vignette-controls"), "Strength", "--zr-photo-vignette", 0, 100, CONFIG.photo.vignette);
      const selectiveTabs = document.querySelector("#selective-tabs");
      channelNames.forEach((name, index) => {
        const button = document.createElement("button");
        button.type = "button";
        button.dataset.channel = index;
        button.title = name;
        button.setAttribute("aria-label", name);
        button.setAttribute("aria-pressed", index === selectedChannel ? "true" : "false");
        button.addEventListener("click", () => selectChannel(index));
        selectiveTabs.append(button);
      });
      const selective = document.querySelector("#selective-controls");
      slider(selective, "Hue", "--zr-photo-selective-active-hue", -100, 100, 0);
      slider(selective, "Saturation", "--zr-photo-selective-active-saturation", -100, 100, 0);
      slider(selective, "Luminance", "--zr-photo-selective-active-luminance", -100, 100, 0);
      CONFIG.photo.selective.forEach((value, index) => {
        setVariable(`--zr-photo-selective-${index}-hue`, value.hue);
        setVariable(`--zr-photo-selective-${index}-saturation`, value.saturation);
        setVariable(`--zr-photo-selective-${index}-luminance`, value.luminance);
      });
      for (const input of selective.querySelectorAll("input")) {
        input.addEventListener("input", () => {
          const property = input.dataset.variable.split("-").at(-1);
          setVariable(`--zr-photo-selective-${selectedChannel}-${property}`, input.value);
        });
      }
      selectChannel(0);

      const levels = document.querySelector("#levels-controls");
      slider(levels, "Input Black", "--zr-photo-level-input-black", 0, 100, CONFIG.photo.levels.inputBlack);
      slider(levels, "Midtone", "--zr-photo-level-midtone", 0, 100, CONFIG.photo.levels.midtone);
      slider(levels, "Input White", "--zr-photo-level-input-white", 0, 100, CONFIG.photo.levels.inputWhite);
      slider(levels, "Output Black", "--zr-photo-level-output-black", 0, 100, CONFIG.photo.levels.outputBlack);
      slider(levels, "Output White", "--zr-photo-level-output-white", 0, 100, CONFIG.photo.levels.outputWhite);

      slider(document.querySelector("#black-white-controls"), "Strength", "--zr-photo-black-and-white", 0, 100, CONFIG.photo.blackAndWhite);
      const color = document.querySelector("#color-controls");
      slider(color, "Saturation", "--zr-photo-saturation", -100, 100, CONFIG.photo.saturation);
      slider(color, "Vibrance", "--zr-photo-vibrance", -100, 100, CONFIG.photo.vibrance);

      const light = document.querySelector("#light-controls");
      [
        ["Brilliance", "brilliance"], ["Exposure", "exposure"], ["Highlights", "highlights"],
        ["Shadows", "shadows"], ["Brightness", "brightness"], ["Contrast", "contrast"], ["Black Point", "blackPoint"]
      ].forEach(([label, key]) => slider(light, label, `--zr-photo-${key.replace(/[A-Z]/g, match => `-${match.toLowerCase()}`)}`, -100, 100, CONFIG.photo[key]));

      const filterButtons = document.querySelector("#filter-buttons");
      filterNames.forEach(name => {
        const button = document.createElement("button");
        button.type = "button";
        button.textContent = name;
        button.dataset.filter = name;
        button.setAttribute("aria-pressed", name === selectedFilter ? "true" : "false");
        button.addEventListener("click", () => {
          selectedFilter = name;
          filterButtons.querySelectorAll("button").forEach(item => item.setAttribute("aria-pressed", item === button ? "true" : "false"));
          scheduleRender();
        });
        filterButtons.append(button);
      });
      slider(document.querySelector("#filter-controls"), "Strength", "--zr-photo-filter-strength", 0, 100, CONFIG.photo.filterStrength);
    }

    function selectChannel(index) {
      selectedChannel = index;
      document.querySelectorAll("#selective-tabs button").forEach(button => button.setAttribute("aria-pressed", Number(button.dataset.channel) === index ? "true" : "false"));
      for (const property of ["hue", "saturation", "luminance"]) {
        const value = getVariable(`--zr-photo-selective-${index}-${property}`);
        setVariable(`--zr-photo-selective-active-${property}`, value);
        const input = document.querySelector(`[data-variable="--zr-photo-selective-active-${property}"]`);
        input.value = value;
        input.nextElementSibling.value = Math.round(value);
      }
    }

    function photoValues() {
      return {
        vignette: getVariable("--zr-photo-vignette"),
        selective: channelNames.map((_, index) => ({
          hue: getVariable(`--zr-photo-selective-${index}-hue`),
          saturation: getVariable(`--zr-photo-selective-${index}-saturation`),
          luminance: getVariable(`--zr-photo-selective-${index}-luminance`)
        })),
        levels: {
          inputBlack: getVariable("--zr-photo-level-input-black"),
          midtone: getVariable("--zr-photo-level-midtone"),
          inputWhite: getVariable("--zr-photo-level-input-white"),
          outputBlack: getVariable("--zr-photo-level-output-black"),
          outputWhite: getVariable("--zr-photo-level-output-white")
        },
        blackAndWhite: getVariable("--zr-photo-black-and-white"),
        saturation: getVariable("--zr-photo-saturation"),
        vibrance: getVariable("--zr-photo-vibrance"),
        brilliance: getVariable("--zr-photo-brilliance"),
        exposure: getVariable("--zr-photo-exposure"),
        highlights: getVariable("--zr-photo-highlights"),
        shadows: getVariable("--zr-photo-shadows"),
        brightness: getVariable("--zr-photo-brightness"),
        contrast: getVariable("--zr-photo-contrast"),
        blackPoint: getVariable("--zr-photo-black-point"),
        filter: selectedFilter,
        filterStrength: getVariable("--zr-photo-filter-strength")
      };
    }

    function drawText() {
      primaryText.textContent = document.querySelector("#primary-input").value.toUpperCase();
      secondaryText.textContent = document.querySelector("#secondary-input").value.toUpperCase();
      primaryText.setAttribute("x", getVariable("--zr-primary-x"));
      primaryText.setAttribute("y", getVariable("--zr-primary-y"));
      primaryText.style.fontSize = `${getVariable("--zr-primary-size")}px`;
      primaryText.style.letterSpacing = `${getVariable("--zr-primary-tracking")}px`;
      if (CONFIG.secondary) {
        secondaryText.setAttribute("x", CONFIG.secondary.anchor_x);
        secondaryText.setAttribute("y", CONFIG.secondary.baseline_y);
        secondaryText.style.fontSize = `${CONFIG.secondary.font_size}px`;
        secondaryText.style.letterSpacing = `${CONFIG.secondary.letter_spacing}px`;
      }
      if (CONFIG.editorial) {
        editorialLayer.hidden = false;
        const divider = CONFIG.editorial.divider;
        const dividerCenter = divider.x + divider.width / 2;
        editorialDivider.setAttribute("x1", dividerCenter);
        editorialDivider.setAttribute("x2", dividerCenter);
        editorialDivider.setAttribute("y1", divider.y);
        editorialDivider.setAttribute("y2", divider.y + divider.height);
        editorialDivider.setAttribute("stroke-width", divider.width);
        const diamondY = CONFIG.editorial.diamond_center_y;
        editorialDiamond.setAttribute("d", `M ${dividerCenter} ${diamondY - 13} L ${dividerCenter + 13} ${diamondY} L ${dividerCenter} ${diamondY + 13} L ${dividerCenter - 13} ${diamondY} Z`);
        editorialText.replaceChildren();
        editorialText.setAttribute("x", CONFIG.editorial.list.x);
        editorialText.setAttribute("y", CONFIG.editorial.list.first_baseline_y);
        editorialText.style.fontSize = `${CONFIG.editorial.list.font_size}px`;
        editorialText.style.letterSpacing = `${CONFIG.editorial.list.letter_spacing}px`;
        CONFIG.editorial.list.lines.forEach((line, index) => {
          const span = document.createElementNS("http://www.w3.org/2000/svg", "tspan");
          span.setAttribute("x", CONFIG.editorial.list.x);
          span.setAttribute("dy", index === 0 ? 0 : CONFIG.editorial.list.line_height);
          span.textContent = line;
          editorialText.append(span);
        });
      }
    }

    function scheduleRender() {
      if (framePending) return;
      framePending = true;
      requestAnimationFrame(() => {
        framePending = false;
        processor.set(photoValues());
        drawText();
      });
    }

    function neutralSettings(values) {
      const clean = ZRPhotoAdjustments.defaults();
      return JSON.stringify(values) === JSON.stringify(clean);
    }

    function verifyNeutralPixel(values) {
      if (!neutralSettings(values)) return { status: "skipped", delta: null };
      const probe = document.createElement("canvas");
      probe.width = source.naturalWidth;
      probe.height = source.naturalHeight;
      const context = probe.getContext("2d", { willReadFrequently: true });
      context.drawImage(source, 0, 0);
      const x = Math.floor(source.naturalWidth * 0.37);
      const y = Math.floor(source.naturalHeight * 0.63);
      const expected = context.getImageData(x, y, 1, 1).data;
      const actual = new Uint8Array(4);
      processor.gl.readPixels(x, source.naturalHeight - y - 1, 1, 1, processor.gl.RGBA, processor.gl.UNSIGNED_BYTE, actual);
      const delta = Math.max(...[0, 1, 2].map(index => Math.abs(expected[index] - actual[index])));
      return { status: delta <= 2 ? "pass" : "fail", delta };
    }

    function initialize() {
      makeControls();
      document.querySelector("#primary-input").value = CONFIG.primary_text;
      document.querySelector("#secondary-input").value = CONFIG.secondary_text;
      document.querySelector("#primary-input").addEventListener("input", scheduleRender);
      document.querySelector("#secondary-input").addEventListener("input", scheduleRender);
      root.style.setProperty("--zr-primary-family", CONFIG.primary.font_family);
      root.style.setProperty("--zr-primary-weight", CONFIG.primary.font_weight);
      root.style.setProperty("--zr-text-color", CONFIG.primary.color);
      root.style.setProperty("--zr-text-shadow", CONFIG.primary.shadow);
      source.src = CONFIG.background;
      source.addEventListener("load", () => {
        processor.setImage(source);
        processor.set(photoValues());
        drawText();
        const test = verifyNeutralPixel(photoValues());
        document.body.dataset.neutralTest = test.status;
        status.textContent = test.status === "pass" ? `Fond neutre vérifié, écart maximal ${test.delta}` : `Test neutre ${test.status}`;
        document.body.dataset.renderReady = "true";
      }, { once: true });
      source.addEventListener("error", () => { throw new Error(`Fond introuvable : ${CONFIG.background}`); }, { once: true });
    }

    document.querySelector("#reset").addEventListener("click", () => location.reload());
    document.querySelector("#copy").addEventListener("click", async () => {
      const payload = {
        template_id: CONFIG.template_id,
        primary_text: document.querySelector("#primary-input").value,
        secondary_text: document.querySelector("#secondary-input").value,
        primary: {
          anchor_x: getVariable("--zr-primary-x"), baseline_y: getVariable("--zr-primary-y"),
          font_size: getVariable("--zr-primary-size"), letter_spacing: getVariable("--zr-primary-tracking")
        },
        photo: photoValues()
      };
      await navigator.clipboard.writeText(JSON.stringify(payload, null, 2));
      status.textContent = "Valeurs copiées";
    });
    if (new URLSearchParams(location.search).has("render")) root.classList.add("render");
    initialize();
  </script>
</body>
</html>
